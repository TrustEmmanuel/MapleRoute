# Copy this file to .env and fill in your Supabase project values.
# Only use the anon (public) key here — never the service_role key.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: cookieless analytics and error monitoring.
# Replace the REPLACE_WITH_ placeholders to switch telemetry on.
# Leaving them as-is (or blank) disables telemetry completely — no third-party requests.
# Umami Cloud: Websites → your site → Website ID (a UUID).
EXPO_PUBLIC_UMAMI_WEBSITE_ID=REPLACE_WITH_UMAMI_WEBSITE_ID
# Only for self-hosted Umami. Leave blank to use Umami Cloud.
EXPO_PUBLIC_UMAMI_SCRIPT_URL=
# Optional comma-separated domains Umami should count, e.g. mapleroute.app
EXPO_PUBLIC_UMAMI_DOMAINS=
# Sentry (or GlitchTip) project DSN, format https://<key>@o<org>.ingest.sentry.io/<project>.
# Use the public DSN, never an auth token.
EXPO_PUBLIC_SENTRY_DSN=REPLACE_WITH_SENTRY_DSN
# Environment label shown in Sentry. Defaults to production/development.
EXPO_PUBLIC_TELEMETRY_ENV=
# Release tag shown in Sentry. Defaults to 0.1.0.
EXPO_PUBLIC_APP_VERSION=
