{
  "id": "/",
  "name": "MapleRoute — Express Entry guide",
  "short_name": "MapleRoute",
  "description": "A step-by-step Express Entry guide with a CRS calculator, document dates and offline reading.",
  "lang": "en-CA",
  "dir": "ltr",
  "start_url": "/express-entry",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#FFFFFF",
  "theme_color": "#D52B1E",
  "categories": ["education", "productivity", "travel"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
